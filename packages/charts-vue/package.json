{
  "name": "@company/charts-vue",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "dev": "vue-tsc --noEmit -p tsconfig.json --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./line": {
      "types": "./dist/line.d.ts",
      "import": "./dist/line.js"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "dependencies": {
    "@company/charts-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "3.5.45",
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "vue": "3.5.45",
    "echarts": "6.1.0",
    "vue-tsc": "3.3.14",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
