{
  "name": "@company/component-cli",
  "version": "0.0.28",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/sync-contracts.mjs && tsc -p tsconfig.build.json && node scripts/package-probe.mjs && node scripts/package-probe.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "pack:juz": "pnpm run build && node scripts/pack-juz.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "component": "./dist/bin.js",
    "juz": "./dist/bin.js"
  },
  "engines": {
    "node": ">=24.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/test": "1.65.0",
    "semver": "7.8.6",
    "vite": "8.3.8",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@company/contracts": "workspace:*",
    "@types/semver": "7.8.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
