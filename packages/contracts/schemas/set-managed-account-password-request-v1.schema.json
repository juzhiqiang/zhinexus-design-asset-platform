{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "set-managed-account-password-request-v1",
  "type": "object",
  "properties": {
    "expectedRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    }
  },
  "required": [
    "expectedRevision",
    "password"
  ],
  "additionalProperties": false
}
