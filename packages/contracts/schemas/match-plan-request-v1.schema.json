{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "match-plan-request-v1",
  "type": "object",
  "properties": {
    "design": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "mapping": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "integer",
              "const": 1
            },
            "ruleSetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "designId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  "framework": {
                    "type": "string",
                    "enum": [
                      "vue",
                      "react"
                    ]
                  },
                  "variantReleaseId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "designId",
                  "framework",
                  "variantReleaseId"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "schemaVersion",
            "ruleSetId",
            "revision",
            "entries"
          ],
          "additionalProperties": false,
          "description": "Opaque IDs are compared exactly. The runtime validator additionally rejects duplicate designId/framework pairs. This configuration is not eligibility evidence."
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instanceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "designId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              }
            },
            "required": [
              "instanceId",
              "designId"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "schemaVersion",
        "mapping",
        "elements"
      ],
      "additionalProperties": false,
      "description": "The runtime validator additionally requires unique instanceIds. Unknown designIds remain valid input for gap reporting; multiple instances may share a designId."
    },
    "context": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "enum": [
            "vue",
            "react"
          ]
        },
        "frameworkVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
        },
        "echartsVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
        },
        "packageManager": {
          "type": "string",
          "enum": [
            "npm",
            "pnpm"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "framework",
        "frameworkVersion",
        "packageManager",
        "requirements"
      ],
      "additionalProperties": false
    },
    "reactDomVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "props": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                }
              },
              "required": [
                "name",
                "source"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
                },
                "handler": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                }
              },
              "required": [
                "name",
                "handler"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "layout": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "required": [
          "instanceId",
          "props",
          "events"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "design",
    "context"
  ],
  "additionalProperties": false
}
