{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "environment-v1",
  "type": "object",
  "properties": {
    "os": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "arch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "browserVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "browserRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "fontDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "deviceScaleFactor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "renderer": {
      "type": "string",
      "enum": [
        "canvas",
        "svg"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "frameworkVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "echartsVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  },
  "required": [
    "os",
    "arch",
    "browserVersion",
    "browserRevision",
    "fontDigest",
    "locale",
    "timezone",
    "deviceScaleFactor",
    "renderer",
    "width",
    "height",
    "theme",
    "frameworkVersion",
    "echartsVersion"
  ],
  "additionalProperties": false
}
