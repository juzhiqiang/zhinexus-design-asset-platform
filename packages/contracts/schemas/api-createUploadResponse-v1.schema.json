{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "createUploadResponse",
  "type": "object",
  "properties": {
    "uploadSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.{1,2}|[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.[^/]*|/|$))(?!.*(?:[. ]/|[. ]$))[^/\\\\:%?*#<>|\"\\u0000-\\u0020]+(?:/[^/\\\\:%?*#<>|\"\\u0000-\\u0020]+)*$"
          },
          "uploadUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https?://[^\\s]+$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "path",
          "uploadUrl",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "uploadSessionId",
    "files"
  ],
  "additionalProperties": false
}
