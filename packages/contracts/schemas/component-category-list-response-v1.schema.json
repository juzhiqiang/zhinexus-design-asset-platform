{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "component-category-list-response-v1",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "enabled": {
            "type": "boolean"
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "revision"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
