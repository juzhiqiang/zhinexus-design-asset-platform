{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "managed-account-audit-response-v1",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "set-password",
              "update",
              "disable",
              "enable",
              "force-logout"
            ]
          },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          }
        },
        "required": [
          "at",
          "actor",
          "action",
          "accountId",
          "username",
          "result"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
