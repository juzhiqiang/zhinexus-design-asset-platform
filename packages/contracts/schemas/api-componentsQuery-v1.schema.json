{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "componentsQuery",
  "type": "object",
  "properties": {
    "framework": {
      "type": "string",
      "enum": [
        "vue",
        "react"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [],
  "additionalProperties": false
}
