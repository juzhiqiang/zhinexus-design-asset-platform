{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "component-api-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "componentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "framework": {
      "type": "string",
      "enum": [
        "vue",
        "react"
      ]
    },
    "exportName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "exportPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^\\.(?:/[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*)?$"
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "required": {
            "type": "boolean"
          },
          "schema": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "null",
                  "object",
                  "array"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "default": {},
              "enum": {
                "type": "array",
                "items": {},
                "minItems": 1
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maxLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "minItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maxItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "items": {
                "type": "object"
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "minItems": 0
              },
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "Bounded reference-free JSON Schema subset; runtime additionally validates nested definitions, keyword/type consistency, defaults and depth/node limits."
          },
          "editor": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "number",
                  "boolean",
                  "enum",
                  "color",
                  "json"
                ]
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "type",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
          },
          "payload": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "schema": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "null",
                  "object",
                  "array"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "default": {},
              "enum": {
                "type": "array",
                "items": {},
                "minItems": 1
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maxLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "minItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maxItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "items": {
                "type": "object"
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "minItems": 0
              },
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "Bounded reference-free JSON Schema subset; runtime additionally validates nested definitions, keyword/type consistency, defaults and depth/node limits."
          }
        },
        "required": [
          "name",
          "payload"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "styleExport": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^\\./[a-zA-Z0-9_/-]+\\.css$"
    },
    "readyMethod": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "componentId",
    "framework",
    "exportName",
    "exportPath",
    "props",
    "events",
    "notes"
  ],
  "additionalProperties": false
}
