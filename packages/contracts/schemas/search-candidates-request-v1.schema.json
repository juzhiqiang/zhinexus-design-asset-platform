{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search-candidates-request-v1",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "context": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "enum": [
            "vue",
            "react"
          ]
        },
        "frameworkVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
        },
        "echartsVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
        },
        "packageManager": {
          "type": "string",
          "enum": [
            "npm",
            "pnpm"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "framework",
        "frameworkVersion",
        "packageManager",
        "requirements"
      ],
      "additionalProperties": false
    },
    "reactDomVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    }
  },
  "required": [
    "query",
    "context"
  ],
  "additionalProperties": false
}
