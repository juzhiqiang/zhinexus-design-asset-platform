{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "completeUploadRequest",
  "type": "object",
  "properties": {
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.{1,2}|[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.[^/]*|/|$))(?!.*(?:[. ]/|[. ]$))[^/\\\\:%?#<>|\"\\u0000-\\u0020]+(?:/[^/\\\\:%?#<>|\"\\u0000-\\u0020]+)*$"
          },
          "partNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "etag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "required": [
          "path",
          "partNumber",
          "etag"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "parts"
  ],
  "additionalProperties": false
}
