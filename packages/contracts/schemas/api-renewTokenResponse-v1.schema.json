{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "renewTokenResponse",
  "type": "object",
  "properties": {
    "accessToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "expiresIn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "accessToken",
    "expiresIn"
  ],
  "additionalProperties": false
}
