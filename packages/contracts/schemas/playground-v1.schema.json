{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "playground-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "adapter": {
      "type": "string",
      "enum": [
        "auto",
        "custom"
      ]
    },
    "props": {
      "type": "object",
      "additionalProperties": {}
    },
    "data": {},
    "dataProp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "boolean",
              "enum",
              "color",
              "json"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "props": {
            "type": "object",
            "additionalProperties": {}
          },
          "data": {}
        },
        "required": [
          "id",
          "label",
          "props"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "adapter",
    "props",
    "controls",
    "states"
  ],
  "additionalProperties": false
}
