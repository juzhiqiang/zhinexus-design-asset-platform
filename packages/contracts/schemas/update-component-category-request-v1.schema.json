{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update-component-category-request-v1",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "enabled": {
      "type": "boolean"
    },
    "expectedRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    }
  },
  "required": [
    "name",
    "enabled",
    "expectedRevision"
  ],
  "additionalProperties": false
}
