{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "create-component-category-request-v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false
}
