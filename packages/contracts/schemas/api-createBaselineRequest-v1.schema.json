{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "createBaselineRequest",
  "type": "object",
  "properties": {
    "variantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "exampleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "environmentKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "screenshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "expectedRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  },
  "required": [
    "variantId",
    "exampleId",
    "environmentKey",
    "screenshotId",
    "reason"
  ],
  "additionalProperties": false
}
