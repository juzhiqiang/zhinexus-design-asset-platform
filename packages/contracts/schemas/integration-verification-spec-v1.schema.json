{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "integration-verification-spec-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z]:/"
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "applyResultDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "type",
              "build"
            ]
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$"
          },
          "manifestPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.{1,2}|[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.[^/]*|/|$))(?!.*(?:[. ]/|[. ]$))[^/\\\\:%?*#<>|\"\\u0000-\\u001f\\u007f]+(?:/[^/\\\\:%?*#<>|\"\\u0000-\\u001f\\u007f]+)*$"
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          },
          "outputDirectories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.{1,2}|[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.[^/]*|/|$))(?!.*(?:[. ]/|[. ]$))[^/\\\\:%?*#<>|\"\\u0000-\\u001f\\u007f]+(?:/[^/\\\\:%?*#<>|\"\\u0000-\\u001f\\u007f]+)*$"
            },
            "minItems": 0
          }
        },
        "required": [
          "kind",
          "script",
          "manifestPath",
          "manifestSha256",
          "timeoutMs",
          "outputDirectories"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "browser": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "readySelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "viewport": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "renderer": {
          "type": "string",
          "enum": [
            "canvas",
            "svg"
          ]
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "click",
                  "fill"
                ]
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              },
              "value": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "kind",
              "selector"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "visible",
                  "text",
                  "count"
                ]
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              },
              "value": {
                "type": "string",
                "maxLength": 4096
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "selector"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "visual": {
          "type": "object",
          "properties": {
            "baseline": {
              "type": "object",
              "properties": {
                "image": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.{1,2}|[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.[^/]*|/|$))(?!.*(?:[. ]/|[. ]$))[^/\\\\:%?*#<>|\"\\u0000-\\u0020]+(?:/[^/\\\\:%?*#<>|\"\\u0000-\\u0020]+)*$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "bytes"
                  ],
                  "additionalProperties": false
                },
                "environment": {
                  "type": "object",
                  "properties": {
                    "os": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "arch": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "browserVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "browserRevision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "fontDigest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "locale": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "timezone": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "deviceScaleFactor": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "renderer": {
                      "type": "string",
                      "enum": [
                        "canvas",
                        "svg"
                      ]
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "theme": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "frameworkVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
                    },
                    "echartsVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
                    }
                  },
                  "required": [
                    "os",
                    "arch",
                    "browserVersion",
                    "browserRevision",
                    "fontDigest",
                    "locale",
                    "timezone",
                    "deviceScaleFactor",
                    "renderer",
                    "width",
                    "height",
                    "theme",
                    "frameworkVersion"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "image",
                "environment"
              ],
              "additionalProperties": false
            },
            "pixelThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxDiffPixelRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "baseline",
            "pixelThreshold",
            "maxDiffPixelRatio"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "url",
        "readySelector",
        "timeoutMs",
        "viewport",
        "renderer",
        "theme",
        "actions",
        "assertions"
      ],
      "additionalProperties": false
    },
    "businessGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "data-source",
          "event-handler",
          "route",
          "authentication",
          "visual-baseline"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "projectRoot",
    "planDigest",
    "applyResultDigest",
    "commands",
    "businessGaps"
  ],
  "additionalProperties": false,
  "description": "Declarative local verification only, never execution authorization. Runtime proves physical paths, approved script bytes, local host trust, actual artifacts and environment."
}
