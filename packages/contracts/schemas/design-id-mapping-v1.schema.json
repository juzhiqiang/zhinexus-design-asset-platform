{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "design-id-mapping-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "ruleSetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "designId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "framework": {
            "type": "string",
            "enum": [
              "vue",
              "react"
            ]
          },
          "variantReleaseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "required": [
          "designId",
          "framework",
          "variantReleaseId"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "ruleSetId",
    "revision",
    "entries"
  ],
  "additionalProperties": false,
  "description": "Opaque IDs are compared exactly. The runtime validator additionally rejects duplicate designId/framework pairs. This configuration is not eligibility evidence."
}
