{
  "name": "@company/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "schemas:generate": "pnpm build && tsx scripts/generate-schemas.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "dependencies": {
    "tldts": "7.4.22"
  }
}
