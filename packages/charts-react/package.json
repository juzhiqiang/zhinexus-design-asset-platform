{
  "name": "@company/charts-react",
  "version": "0.0.7",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-style.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./line": {
      "types": "./dist/line.d.ts",
      "import": "./dist/line.js"
    },
    "./bar": {
      "types": "./dist/bar.d.ts",
      "import": "./dist/bar.js"
    },
    "./pie": {
      "types": "./dist/pie.d.ts",
      "import": "./dist/pie.js"
    },
    "./scatter": {
      "types": "./dist/scatter.d.ts",
      "import": "./dist/scatter.js"
    },
    "./trend-card": {
      "types": "./dist/trend-card.d.ts",
      "import": "./dist/trend-card.js"
    },
    "./ranking": {
      "types": "./dist/ranking.d.ts",
      "import": "./dist/ranking.js"
    },
    "./proportion": {
      "types": "./dist/proportion.d.ts",
      "import": "./dist/proportion.js"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "dependencies": {
    "@company/charts-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "echarts": "6.1.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
