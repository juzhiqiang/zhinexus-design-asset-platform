{
  "realm": "zhinexus",
  "enabled": true,
  "displayName": "Zhinexus 设计资产平台",
  "displayNameHtml": "<b>Zhinexus</b> 设计资产平台",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "passwordPolicy": "hashIterations(27500) and length(14) and notUsername and maxLength(256) and lowerCase(1) and upperCase(1) and digits(1)",
  "requiredActions": [
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": true, "priority": 10 }
  ],
  "roles": {
    "realm": [
      { "name": "reader", "description": "读取私有资产与预览" },
      { "name": "publisher", "description": "提交与发布组件产物" },
      { "name": "maintainer", "description": "维护基线与版本生命周期" },
      { "name": "platform-administrator", "description": "平台账号与权限后台，不由成员接口授予" }
    ]
  },
  "clients": [
    {
      "clientId": "zhinexus-web",
      "name": "资产平台画廊",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["__PLATFORM_API_ORIGIN__/v1/auth/oidc/callback"],
      "webOrigins": ["__PLATFORM_GALLERY_ORIGIN__"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "__PLATFORM_GALLERY_ORIGIN__/*" },
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        { "name": "platform-account-version", "protocol": "openid-connect", "protocolMapper": "oidc-users-attribute-mapper",
          "consentRequired": false, "config": { "user.attribute": "platform_account_version", "claim.name": "platform_account_version", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "false", "aggregate.attrs": "false" } },
        { "name": "platform-managed-user-id", "protocol": "openid-connect", "protocolMapper": "oidc-users-attribute-mapper",
          "consentRequired": false, "config": { "user.attribute": "platform_managed_user_id", "claim.name": "platform_managed_user_id", "jsonType.label": "String", "id.token.claim": "false", "access.token.claim": "true", "userinfo.token.claim": "false", "aggregate.attrs": "false" } },
        { "name": "api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false, "config": { "included.client.audience": "zhinexus-api", "access.token.claim": "true", "id.token.claim": "false" } },
        { "name": "auth-time", "protocol": "openid-connect", "protocolMapper": "oidc-users-session-attribute-mapper",
          "consentRequired": false, "config": { "user.session.note": "auth_time", "claim.name": "auth_time", "jsonType.label": "int", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "false" } },
        { "name": "realm-roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false, "config": { "claim.name": "roles", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" } }
      ]
    },
    {
      "clientId": "zhinexus-cli",
      "name": "组件 CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://127.0.0.1:__PLATFORM_CLI_REDIRECT_PORT__/callback", "http://localhost:__PLATFORM_CLI_REDIRECT_PORT__/callback"],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        { "name": "platform-account-version", "protocol": "openid-connect", "protocolMapper": "oidc-users-attribute-mapper",
          "consentRequired": false, "config": { "user.attribute": "platform_account_version", "claim.name": "platform_account_version", "jsonType.label": "String", "id.token.claim": "false", "access.token.claim": "true", "userinfo.token.claim": "false", "aggregate.attrs": "false" } },
        { "name": "platform-managed-user-id", "protocol": "openid-connect", "protocolMapper": "oidc-users-attribute-mapper",
          "consentRequired": false, "config": { "user.attribute": "platform_managed_user_id", "claim.name": "platform_managed_user_id", "jsonType.label": "String", "id.token.claim": "false", "access.token.claim": "true", "userinfo.token.claim": "false", "aggregate.attrs": "false" } },
        { "name": "api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false, "config": { "included.client.audience": "zhinexus-api", "access.token.claim": "true", "id.token.claim": "false" } },
        { "name": "auth-time", "protocol": "openid-connect", "protocolMapper": "oidc-users-session-attribute-mapper",
          "consentRequired": false, "config": { "user.session.note": "auth_time", "claim.name": "auth_time", "jsonType.label": "int", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" } },
        { "name": "realm-roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false, "config": { "claim.name": "roles", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" } }
      ]
    },
    {
      "clientId": "zhinexus-api",
      "name": "平台管理 API（受众）",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {}
    },
    {
      "clientId": "zhinexus-identity-admin",
      "name": "平台身份管理服务账号",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {},
      "defaultClientScopes": ["roles"],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    { "name": "roles", "description": "业务角色", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" } }
  ],
  "users": []
}
