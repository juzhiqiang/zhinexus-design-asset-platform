              "x": 78,
              "y": 127,
              "name": "原生分区标题",
              "fill": "#F0F1F4",
              "textGrowth": "fixed-width",
              "width": 650,
              "content": "一种资产语言。\n两种原生表达。",
              "lineHeight": 1.4,
              "fontFamily": "Noto Sans SC",
              "fontSize": 42,
              "fontWeight": "500",
              "letterSpacing": -1
            },
            {
              "type": "text",
              "id": "CcKA1",
              "x": 80,
              "y": 286,
              "name": "原生分区说明",
              "fill": "#A0A5B0",
              "textGrowth": "fixed-width",
              "width": 660,
              "content": "不为框架妥协，也不重复创造。\nVue 与 React 独立实现，共享核心能力。",
              "lineHeight": 1.9,
              "fontFamily": "Noto Sans SC",
              "fontSize": 16,
              "fontWeight": "normal"
