              { "x": "直投", "y": 80 },
              { "x": "自然", "y": null },
              { "x": "合作", "y": 100 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["share"]
    },
    "empty": {
      "donut": true,
      "data": { "series": [] },
      "expectedSeriesIds": []
    },
    "missing": {
