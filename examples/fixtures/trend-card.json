{
  "component": "trend-card",
  "description": "双框架示例共用确定性数据与状态定义；examples/vue 与 examples/react 必须保持完全一致，截图与点击载荷才能等价。x 为类目轴（时间/期间）、y 为数值；当前值取第一个系列最后一个非缺失值，前期值固定在示例 config（previousValue）不随状态变化，状态只改数据以保证空状态经 update 到达、不重建控制器。多状态覆盖空数据、缺失值、单点、更新与下降。",
  "previousValue": 160,
  "states": {
    "default": {
      "data": {
        "series": [
          {
            "id": "active",
            "name": "活跃用户",
            "points": [
              { "x": "周一", "y": 120 },
              { "x": "周二", "y": 150 },
              { "x": "周三", "y": 180 },
              { "x": "周四", "y": 200 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["active"]
    },
    "empty": {
      "data": { "series": [] },
      "expectedSeriesIds": []
    },
    "missing": {
      "data": {
        "series": [
          {
            "id": "active",
            "name": "活跃用户",
            "points": [
              { "x": "周一", "y": 120 },
              { "x": "周二", "y": null },
              { "x": "周三", "y": 180 },
              { "x": "周四", "y": 200 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["active"]
    },
    "single": {
      "data": {
        "series": [
          {
            "id": "active",
            "name": "活跃用户",
            "points": [
              { "x": "周一", "y": 200 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["active"]
    },
    "updated": {
      "data": {
        "series": [
          {
            "id": "active",
            "name": "活跃用户",
            "points": [
              { "x": "周一", "y": 210 },
              { "x": "周二", "y": 190 },
              { "x": "周三", "y": 230 },
              { "x": "周四", "y": 240 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["active"]
    },
    "down": {
      "data": {
        "series": [
          {
            "id": "active",
            "name": "活跃用户",
            "points": [
              { "x": "周一", "y": 200 },
              { "x": "周二", "y": 180 },
              { "x": "周三", "y": 150 },
              { "x": "周四", "y": 120 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["active"]
    }
  }
}
