{
  "component": "proportion",
  "description": "双框架示例共用确定性数据与状态定义；examples/vue 与 examples/react 必须保持完全一致，截图与点击载荷才能等价。points[].x 为条目名称、points[].y 为数值；条目顺序保持输入顺序（占比场景不排序，需要排序时用排行榜），占比 = 值 / 全部非缺失值之和，缺失值（null）不参与分母。总量为零（全零或全缺失）时展示「暂无数据」且不产出 NaN%。负值在组件外就应被拒绝（ChartDataError）。状态只改数据以保证空状态经 update 到达、不重建控制器。多状态覆盖空数据、零总量、缺失值、单条目与更新。",
  "states": {
    "default": {
      "data": {
        "series": [
          {
            "id": "source",
            "name": "来源",
            "points": [
              { "x": "搜索", "y": 120 },
              { "x": "直投", "y": 80 },
              { "x": "自然", "y": null },
              { "x": "合作", "y": 100 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["source"]
    },
    "empty": {
      "data": { "series": [] },
      "expectedSeriesIds": []
    },
    "zero-total": {
      "data": {
        "series": [
          {
            "id": "source",
            "name": "来源",
            "points": [
              { "x": "搜索", "y": 0 },
              { "x": "直投", "y": 0 },
              { "x": "自然", "y": 0 }
            ]
          }
        ]
      },
      "expectedSeriesIds": []
    },
    "missing": {
      "data": {
        "series": [
          {
            "id": "source",
            "name": "来源",
            "points": [
              { "x": "搜索", "y": 120 },
              { "x": "直投", "y": null },
              { "x": "自然", "y": 60 },
              { "x": "合作", "y": 100 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["source"]
    },
    "single": {
      "data": {
        "series": [
          {
            "id": "source",
            "name": "来源",
            "points": [
              { "x": "搜索", "y": 300 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["source"]
    },
    "updated": {
      "data": {
        "series": [
          {
            "id": "source",
            "name": "来源",
            "points": [
              { "x": "搜索", "y": 210 },
              { "x": "直投", "y": 90 },
              { "x": "自然", "y": 30 },
              { "x": "合作", "y": 170 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["source"]
    }
  }
}
