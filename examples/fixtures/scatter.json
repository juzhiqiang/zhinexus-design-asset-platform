{
  "component": "scatter",
  "description": "双框架示例共用确定性数据与状态定义；examples/vue 与 examples/react 必须保持完全一致，截图与点击载荷才能等价。x 为数值轴坐标、y 为数值，多状态覆盖空数据、缺失值、负值、单系列与更新。",
  "states": {
    "default": {
      "data": {
        "series": [
          {
            "id": "revenue",
            "name": "收入",
            "points": [
              { "x": 1, "y": 120 },
              { "x": 2, "y": 180 },
              { "x": 3, "y": 150 },
              { "x": 4, "y": 200 }
            ]
          },
          {
            "id": "cost",
            "name": "成本",
            "points": [
              { "x": 1, "y": 40 },
              { "x": 2, "y": 60 },
              { "x": 3, "y": 55 },
              { "x": 4, "y": 80 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["revenue", "cost"]
    },
    "empty": {
      "data": { "series": [] },
      "expectedSeriesIds": []
    },
    "missing": {
      "data": {
        "series": [
          {
            "id": "revenue",
            "name": "收入",
            "points": [
              { "x": 1, "y": 120 },
              { "x": 2, "y": null },
              { "x": 3, "y": 150 },
              { "x": 4, "y": null }
            ]
          },
          {
            "id": "cost",
            "name": "成本",
            "points": [
              { "x": 1, "y": 40 },
              { "x": 2, "y": 60 },
              { "x": 3, "y": null },
              { "x": 4, "y": 80 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["revenue", "cost"]
    },
    "negative": {
      "data": {
        "series": [
          {
            "id": "revenue",
            "name": "收入",
            "points": [
              { "x": 1, "y": 120 },
              { "x": 2, "y": -40 },
              { "x": 3, "y": 60 },
              { "x": 4, "y": null }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["revenue"]
    },
    "single": {
      "data": {
        "series": [
          {
            "id": "revenue",
            "name": "收入",
            "points": [
              { "x": 1, "y": 120 },
              { "x": 2, "y": 180 },
              { "x": 3, "y": 150 },
              { "x": 4, "y": 200 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["revenue"]
    },
    "updated": {
      "data": {
        "series": [
          {
            "id": "revenue",
            "name": "收入",
            "points": [
              { "x": 1, "y": 200 },
              { "x": 2, "y": 260 },
              { "x": 3, "y": 190 },
              { "x": 4, "y": 240 }
            ]
          },
          {
            "id": "cost",
            "name": "成本",
            "points": [
              { "x": 1, "y": 50 },
              { "x": 2, "y": 70 },
              { "x": 3, "y": 65 },
              { "x": 4, "y": 95 }
            ]
          }
        ]
      },
      "expectedSeriesIds": ["revenue", "cost"]
    }
  }
}
