  "negativeCases": [
    {
      "caseId": "neg-fake-sdk-import",
      "reason": "伪 SDK import（非真实 @company/charts-* 子路径）必须被拒绝",
      "framework": "react",
      "componentId": "line",
      "expectedRejectedRule": "INVALID_SDK_IMPORT"
    },
    {
      "caseId": "neg-other-component-prop",
      "reason": "传入另一组件专属 prop 或未知 prop（如 Ranking 传入 xAxisUnit）必须被拒绝",
      "framework": "vue",
      "componentId": "ranking",
      "expectedRejectedRule": "UNKNOWN_OR_FOREIGN_PROP"
    },
    {
      "caseId": "neg-wrong-framework-event",
      "reason": "跨框架错用事件名（Vue 使用 @onPointClick 或 React 使用 point-click）必须被拒绝",
      "framework": "vue",
      "componentId": "line",
      "expectedRejectedRule": "WRONG_EVENT_NAME"
    },
    {
      "caseId": "neg-unrendered-function",
      "reason": "仅导入或声明函数但未在模板/JSX 实际渲染组件必须被拒绝",
      "framework": "react",
      "componentId": "line",
      "expectedRejectedRule": "COMPONENT_NOT_RENDERED"
    },
    {
      "caseId": "neg-local-shadowing",
      "reason": "局部同名声明（const LineChart = ...）遮蔽 SDK 导入必须被拒绝",
      "framework": "react",
      "componentId": "line",
      "expectedRejectedRule": "LOCAL_SYMBOL_SHADOWING"
    },
    {
      "caseId": "neg-unrelated-literal",
      "reason": "仅在字符串字面量或注释中出现导出名/包名而未真实导入渲染必须被拒绝",
      "framework": "vue",
      "componentId": "ranking",
      "expectedRejectedRule": "UNRELATED_STRING_LITERAL_ONLY"
    },
    {
      "caseId": "neg-trailing-spread-override",
      "reason": "在必需 prop 之后使用后置 spread（{...extra} / v-bind=\"extra\"）覆盖绑定必须被拒绝",
      "framework": "react",
      "componentId": "line",
      "expectedRejectedRule": "TRAILING_SPREAD_OVERRIDE"
    },
    {
      "caseId": "neg-unknown-required-binding",
      "reason": "缺少必需 data 绑定或 source/handler 为未知空绑定必须被拒绝",
      "framework": "vue",
      "componentId": "line",
      "expectedRejectedRule": "MISSING_REQUIRED_BINDING"
    }
  ]
