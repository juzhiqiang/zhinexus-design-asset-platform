{
  "componentId": "line",
  "framework": "vue",
  "exportName": "LineChart",
  "exportPath": "./line",
  "props": {
    "data": {
      "type": "ChartData",
      "required": true
    },
    "config": {
      "type": "LineChartConfig",
      "required": false
    },
    "optionOverrides": {
      "type": "EChartsOption",
      "required": false
    }
  },
  "events": {
    "point-click": {
      "payload": "ChartEvent"
    }
  }
}
