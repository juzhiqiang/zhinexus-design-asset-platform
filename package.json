{
  "name": "zhinexus-design-asset-platform",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "build": "turbo run build --cache=local:rw",
    "typecheck": "pnpm build:services && turbo run typecheck --cache=local:rw && tsc -p tsconfig.json --noEmit",
    "dev": "turbo run dev --concurrency=12 --cache=local:rw",
    "test": "pnpm build:services && vitest run",
    "test:browser": "playwright test --config tests/playwright.config.ts",
    "test:gallery-cache": "node tests/integration/gallery-cache.mjs",
    "infra:up": "tsx infra/scripts/local.ts up",
    "infra:stop": "tsx infra/scripts/local.ts stop",
    "test:infra": "tsx infra/scripts/check.ts",
    "test:platform": "pnpm build:services && pnpm --filter @company/charts-core --filter @company/charts-vue --filter @company/charts-react build && vitest run --config tests/platform/vitest.config.ts",
    "rehearse:recovery": "pnpm build:services && tsx scripts/rehearse-recovery.ts",
    "infra:check-access": "tsx infra/scripts/access.ts",
    "verify:workspace": "tsx scripts/verify-workspace.ts",
    "versions:resolve": "node scripts/resolve-versions.mjs",
    "build:services": "turbo run build typecheck --filter=@company/platform-api --filter=@company/preview-gateway --cache=local:rw",
    "component": "node packages/component-cli/dist/index.js"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@company/contracts": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tar-stream": "3.1.5",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "jose": "6.2.17",
    "jpeg-js": "0.4.4",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "tar-stream": "3.2.2",
    "tldts": "7.4.22",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
