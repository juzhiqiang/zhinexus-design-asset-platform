{
  "name": "zhinexus-design-asset-platform",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.6.0",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "build": "turbo run build --cache=local:rw",
    "typecheck": "pnpm build:services && turbo run typecheck --cache=local:rw && tsc -p tsconfig.json --noEmit",
    "dev": "turbo run dev --concurrency=12 --cache=local:rw",
    "test": "pnpm build:services && pnpm test:t10 && vitest run",
    "test:t10": "pnpm --filter @company/contracts build && node --test tests/acceptance/t10-sdk/probe.test.mjs tests/acceptance/t10-sdk/package-probe.test.mjs tests/unit/t10-evidence.test.mjs",
    "test:installed-compatibility": "pnpm build:services && vitest run --config tests/acceptance/installed-compatibility.config.ts",
    "probe:t10": "node tests/acceptance/t10-sdk/probe.mjs",
    "test:browser": "playwright test --config tests/playwright.config.ts",
    "test:gallery-cache": "node tests/integration/gallery-cache.mjs",
    "infra:up": "tsx infra/scripts/local.ts up",
    "infra:self-managed:up": "tsx infra/scripts/self-managed.ts up",
    "infra:self-managed:stop": "tsx infra/scripts/self-managed.ts stop",
    "infra:self-managed:credentials": "tsx infra/scripts/self-managed.ts credentials",
    "infra:self-managed:bootstrap": "pnpm build:services && tsx infra/scripts/self-managed.ts bootstrap",
    "infra:self-managed:bootstrap-local": "pnpm build:services && tsx infra/scripts/self-managed.ts bootstrap-local",
    "infra:stop": "tsx infra/scripts/local.ts stop",
    "test:infra": "tsx infra/scripts/check.ts",
    "test:platform": "pnpm build:services && pnpm --filter @company/charts-core --filter @company/charts-vue --filter @company/charts-react build && vitest run --config tests/platform/vitest.config.ts",
    "verify:deployment": "pnpm build:services && tsx scripts/verify-deployment.ts",
    "preflight:production": "pnpm build:services && tsx scripts/production-preflight.ts",
    "verify:service-staging": "tsx scripts/verify-service-staging.ts",
    "verify:consistency": "pnpm build:services && tsx scripts/verify-consistency.ts",
    "ops:retention": "node apps/api/dist/operations/retention.js",
    "rehearse:backup": "pnpm build:services && vitest run --config tests/platform/vitest.config.ts tests/platform/backup-restore.test.ts",
    "rehearse:recovery": "pnpm build:services && vitest run --config tests/platform/vitest.config.ts tests/platform/platform-acceptance.test.ts tests/platform/preview.test.ts",
    "rehearse:capacity": "pnpm build:services && tsx scripts/rehearse-capacity.ts",
    "infra:check-access": "pnpm --filter @company/contracts build && tsx infra/scripts/access.ts",
    "verify:workspace": "tsx scripts/verify-workspace.ts",
    "versions:resolve": "node scripts/resolve-versions.mjs",
    "build:services": "turbo run build typecheck --filter=@company/platform-api --filter=@company/preview-gateway --cache=local:rw",
    "component": "node packages/component-cli/dist/bin.js"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@company/contracts": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tar-stream": "3.1.5",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "jose": "6.2.17",
    "jpeg-js": "0.4.4",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "tar-stream": "3.2.2",
    "tldts": "7.4.22",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
